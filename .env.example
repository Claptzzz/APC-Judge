# =============================================================================
# juez-online — variables de entorno de DESARROLLO LOCAL
# Copia este archivo a .env (`cp .env.example .env`). Nunca commitees .env.
# Las URLs apuntan al host (localhost). Dentro de la red de docker usa los nombres
# de servicio (postgres:5432, redis, kafka:29092, minio:9000, mcp:4100).
# Sin interpolación ${...}: Node (--env-file / dotenv) no la soporta.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Puertos de apps y servicios (fuente de verdad: docs/architecture.md §Puertos)
# -----------------------------------------------------------------------------
WEB_PORT=5173
BFF_PORT=4000
MCP_PORT=4100
USERS_HTTP_PORT=8081
USERS_GRPC_PORT=50051
PROBLEMS_HTTP_PORT=8082
PROBLEMS_GRPC_PORT=50052
SUBMISSIONS_HTTP_PORT=8083
SUBMISSIONS_GRPC_PORT=50053
RANKING_HTTP_PORT=8084
RANKING_GRPC_PORT=50054
JUDGE_HTTP_PORT=8085

# Direcciones gRPC (host:port). Clientes @grpc/grpc-js (Nest) las usan tal cual;
# clientes Connect usan baseUrl = http://<addr> (HTTP/2 sin TLS en local).
USERS_GRPC_ADDR=localhost:50051
PROBLEMS_GRPC_ADDR=localhost:50052
SUBMISSIONS_GRPC_ADDR=localhost:50053
RANKING_GRPC_ADDR=localhost:50054

# -----------------------------------------------------------------------------
# Infraestructura: puertos publicados en el host
# -----------------------------------------------------------------------------
# 55432 y no 5432: el 5432 suele estar ocupado por un Postgres del sistema.
# Si lo cambias, cambia también el puerto de todas las *_DATABASE_URL.
POSTGRES_PORT=55432
REDIS_PORT=6379
KAFKA_HOST_PORT=9092
KAFKA_UI_PORT=8080
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# PostgreSQL — una instancia en local; una BD + un usuario por servicio
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

USERS_DB_NAME=users
USERS_DB_USER=users_svc
USERS_DB_PASSWORD=users_svc_dev
USERS_DATABASE_URL=postgres://users_svc:users_svc_dev@localhost:55432/users

PROBLEMS_DB_NAME=problems
PROBLEMS_DB_USER=problems_svc
PROBLEMS_DB_PASSWORD=problems_svc_dev
PROBLEMS_DATABASE_URL=postgres://problems_svc:problems_svc_dev@localhost:55432/problems

SUBMISSIONS_DB_NAME=submissions
SUBMISSIONS_DB_USER=submissions_svc
SUBMISSIONS_DB_PASSWORD=submissions_svc_dev
SUBMISSIONS_DATABASE_URL=postgres://submissions_svc:submissions_svc_dev@localhost:55432/submissions

RANKING_DB_NAME=ranking
RANKING_DB_USER=ranking_svc
RANKING_DB_PASSWORD=ranking_svc_dev
RANKING_DATABASE_URL=postgres://ranking_svc:ranking_svc_dev@localhost:55432/ranking

# -----------------------------------------------------------------------------
# Redis (ranking: scoreboard)
# -----------------------------------------------------------------------------
RANKING_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Kafka (KRaft, un nodo). Host: localhost:9092 · red docker: kafka:29092
# -----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=djrZ_aKCR1mfxvzfoWCiMw
KAFKA_BROKERS=localhost:9092

USERS_KAFKA_CLIENT_ID=users
SUBMISSIONS_KAFKA_CLIENT_ID=submissions
SUBMISSIONS_KAFKA_GROUP_ID=submissions
RANKING_KAFKA_CLIENT_ID=ranking
RANKING_KAFKA_GROUP_ID=ranking
JUDGE_KAFKA_CLIENT_ID=judge
JUDGE_KAFKA_GROUP_ID=judge
BFF_KAFKA_CLIENT_ID=bff
# Prefijo: cada réplica del BFF agrega un sufijo único (p. ej. el hostname) para que
# todas reciban todos los veredictos y los empujen a sus propios clientes WS.
BFF_KAFKA_GROUP_ID=bff

# Outbox de submissions
SUBMISSIONS_OUTBOX_POLL_INTERVAL_MS=500
SUBMISSIONS_OUTBOX_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# MinIO / S3 (problems: casos de prueba)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
S3_ENDPOINT=http://localhost:9000
# Host con el que se firman las URLs prefirmadas: debe ser alcanzable por quien las usa
# (navegador del setter y judge). En docker, judge usaría http://minio:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_dev
S3_FORCE_PATH_STYLE=true
S3_BUCKET_TESTCASES=testcases
S3_PRESIGN_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# JWT RS256 (generar con `pnpm jwt:keys`). Solo users usa la llave privada;
# bff y mcp obtienen la pública con UserService.GetPublicKey.
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
JWT_KEY_ID=dev-1
JWT_ISSUER=juez-users
JWT_AUDIENCE=juez
JWT_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# BFF (GraphQL en http://localhost:4000/graphql, HTTP y WebSocket graphql-ws)
# Puerto: BFF_PORT (arriba). Direcciones gRPC: *_GRPC_ADDR (arriba).
# Kafka: KAFKA_BROKERS + BFF_KAFKA_CLIENT_ID / BFF_KAFKA_GROUP_ID (sección Kafka).
# -----------------------------------------------------------------------------
# Origen permitido por CORS (el dev server de Vite). Varios: separados por coma.
BFF_CORS_ORIGIN=http://localhost:5173
# Endpoint Streamable HTTP del MCP server. En docker: http://mcp:4100/mcp
MCP_URL=http://localhost:4100/mcp

# -----------------------------------------------------------------------------
# Gemini (asistente del BFF, SDK @google/genai). Dos modos de autenticación:
#  a) Google AI Studio (Gemini API): GOOGLE_GENAI_USE_VERTEXAI=false + GEMINI_API_KEY.
#  b) Vertex AI: GOOGLE_GENAI_USE_VERTEXAI=true + GOOGLE_CLOUD_PROJECT y
#     GOOGLE_CLOUD_LOCATION, con ADC (`gcloud auth application-default login`) o
#     GOOGLE_APPLICATION_CREDENTIALS (ruta al JSON de una cuenta de servicio).
# El SDK lee estas mismas variables por sí solo.
# -----------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=false
# Modo a) API key de https://aistudio.google.com/apikey. Nunca la commitees (va en .env).
GEMINI_API_KEY=
# Modo b) Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Id estable (GA) vigente en la Gemini API y en Vertex AI, con function calling. Verificado
# en la documentación de Google el 2026-11-22; revisa la página de modelos si deja de estarlo.
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------------
# MCP server (services/mcp). Puerto: MCP_PORT (arriba). Todas tienen valor por defecto.
# -----------------------------------------------------------------------------
MCP_HOST=0.0.0.0
# Hostnames (sin puerto) aceptados en el header Host de /mcp (protección contra DNS
# rebinding). En local basta localhost; en el docker-compose debe incluir `mcp` (el nombre
# del servicio con el que lo llama el BFF), p. ej. localhost,mcp. En k8s, el nombre del Service.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Hostnames aceptados en el header Origin. Vacío = se rechaza toda request de un navegador
# (el BFF llama desde el servidor, sin Origin).
MCP_ALLOWED_ORIGINS=
# Límite del body de /mcp en bytes (413 por encima) y timeout por llamada gRPC.
MCP_MAX_BODY_BYTES=262144
MCP_UPSTREAM_TIMEOUT_MS=3000

# -----------------------------------------------------------------------------
# Web (Vite expone al navegador solo las variables VITE_*)
# -----------------------------------------------------------------------------
VITE_GRAPHQL_URL=http://localhost:4000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# -----------------------------------------------------------------------------
# Judge
# -----------------------------------------------------------------------------
JUDGE_CONCURRENCY=2
JUDGE_WORKDIR=/tmp/juez-judge
JUDGE_COMPILE_TIMEOUT_MS=10000
JUDGE_MAX_OUTPUT_KB=65536
