{
  "name": "@juez/bff",
  "version": "0.0.0",
  "private": true,
  "description": "BFF del juez online: API GraphQL (HTTP + graphql-ws) sobre los servicios gRPC y el asistente (Gemini + MCP)",
  "type": "module",
  "main": "./dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/codegen.mjs",
    "build": "node scripts/codegen.mjs && tsc -p tsconfig.build.json",
    "typecheck": "node scripts/codegen.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.2",
    "@as-integrations/express5": "1.1.2",
    "@google/genai": "3.6.1",
    "@grpc/grpc-js": "1.14.7",
    "@grpc/proto-loader": "0.8.1",
    "@juez/contracts": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@nestjs/apollo": "14.2.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/graphql": "14.2.1",
    "@nestjs/microservices": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prometheus-io/client": "0.16.1",
    "dataloader": "2.2.3",
    "graphql": "16.15.0",
    "graphql-ws": "6.4.1",
    "jose": "6.2.17",
    "kafkajs": "2.2.4",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@graphql-codegen/core": "7.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@juez/config": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
