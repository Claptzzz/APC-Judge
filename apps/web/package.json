{
  "name": "@juez/web",
  "version": "0.0.0",
  "private": true,
  "description": "SPA del juez online: catálogo, editor y envío, veredicto en vivo, contests, scoreboard y asistente",
  "type": "module",
  "scripts": {
    "generate": "graphql-codegen --config codegen.ts",
    "dev": "pnpm run generate && vite",
    "build": "pnpm run generate && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "pnpm run generate && vitest run --coverage"
  },
  "dependencies": {
    "@apollo/client": "4.3.8",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/theme-one-dark": "6.1.3",
    "@codemirror/view": "6.43.15",
    "codemirror": "6.0.2",
    "graphql": "16.15.0",
    "graphql-ws": "6.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.2",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@juez/config": "workspace:*",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
