{
  "name": "@juez/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server del asistente: tools de solo lectura sobre el dominio, ejecutadas con la identidad del usuario",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@juez/contracts": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.17",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@juez/config": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
