{
  "name": "@juez/ranking",
  "version": "0.0.0",
  "private": true,
  "description": "Servicio ranking: contests, scoreboard ICPC (proyección en Redis) y estadísticas por usuario",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:int": "vitest run --config vitest.int.config.ts",
    "start": "node dist/main.js",
    "start:dev": "node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env dist/migrate.js",
    "scoreboard:rebuild": "node --env-file-if-exists=../../.env.example --env-file-if-exists=../../.env dist/scripts/rebuild.js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "@hono/node-server": "2.1.6",
    "@juez/contracts": "workspace:*",
    "@prometheus-io/client": "0.16.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "kafkajs": "2.2.4",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@juez/config": "workspace:*",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
